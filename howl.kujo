# Howl entrypoint.
#
# Thin wrapper: no logic here. Hand the user's arguments to the CLI module and
# translate its return code into a process exit code.
#
# Run with:
#   kujo run howl.kujo -- <command> [options]
# or via the bin/howl wrapper:
#   ./bin/howl <command> [options]

from src.cli import main

code := main(args())
exit(code)
