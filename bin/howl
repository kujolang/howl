#!/usr/bin/env bash
# Howl launcher.
#
# Convenience wrapper so you can type `howl <args>` instead of
# `kujo run /path/to/howl.kujo -- <args>`. It runs the Kujo interpreter on the
# project entrypoint while preserving your current working directory, so the
# manifest and output paths resolve relative to where you invoke it.
#
# Override the interpreter with the KUJO environment variable, e.g.
#   KUJO=/path/to/kujo/target/release/kujo howl render
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
KUJO="${KUJO:-kujo}"

if ! command -v "$KUJO" >/dev/null 2>&1 && [ ! -x "$KUJO" ]; then
  echo "howl: cannot find the Kujo interpreter ('$KUJO')." >&2
  echo "Set KUJO to your kujo binary, e.g. KUJO=/path/to/kujo/target/release/kujo" >&2
  exit 127
fi

exec "$KUJO" run "$PROJECT_DIR/howl.kujo" -- "$@"
