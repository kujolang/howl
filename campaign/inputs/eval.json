{
  "name": "release-gate-suite",
  "description": "Stable passing suite used by release and CI gate checks.",
  "tests": [
    {
      "name": "echo command succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "echo release-gate-ok"
      }
    },
    {
      "name": "repository manifest exists",
      "check": "file_exists",
      "params": {
        "path": "kennel.toml"
      }
    },
    {
      "name": "repository manifest has non-trivial size",
      "check": "file_size_greater_than",
      "params": {
        "path": "kennel.toml",
        "bytes": 100
      }
    }
  ]
}
