# Command-line interface for Howl.
#
# The only module that talks to argv / stdout / the output directory directly,
# so the rest of the code stays pure and testable. Dispatches to the manifest
# model, the three renderers, and the gallery.

from src.util import die, is_blank, comma_list, join_path, ensure_trailing_slash, truthy, is_safe_output_dir, resolve_contained_path
from src.manifest import load_manifest, validate_manifest, build_card, build_card_preview, card_metadata, find_card, manifest_project, default_limits
from src.caption import build_caption, build_caption_x
from src.render_md import render_markdown
from src.render_html import render_html
from src.render_svg import render_svg
from src.gallery import render_gallery

VERSION := "1.1.0"

# ---- argv / option parsing ---------------------------------------------

# Collect flags and positionals after the command word (argv[0]). Value flags
# consume the next token; everything else is a positional.
func parse_opts(argv) {
    mut opts := {}
    opts["manifest"] := "howl.json"
    opts["out"] := "dist/howl"
    opts["format"] := "all"
    opts["platform"] := ""
    opts["force"] := false
    opts["max_code_lines"] := 40
    opts["max_output_lines"] := 20
    mut positionals := []
    n := len(argv)
    mut i := 1
    while i < n {
        arg := argv[i]
        if arg == "--manifest" {
            opts["manifest"] := option_value(argv, i, arg)
            i = i + 1
        } else if arg == "--out" {
            opts["out"] := option_value(argv, i, arg)
            i = i + 1
        } else if arg == "--format" {
            opts["format"] := option_value(argv, i, arg)
            i = i + 1
        } else if arg == "--platform" {
            opts["platform"] := option_value(argv, i, arg)
            i = i + 1
        } else if arg == "--max-code-lines" {
            opts["max_code_lines"] := parse_positive_int(option_value(argv, i, arg), arg)
            i = i + 1
        } else if arg == "--max-output-lines" {
            opts["max_output_lines"] := parse_positive_int(option_value(argv, i, arg), arg)
            i = i + 1
        } else if arg == "--force" {
            opts["force"] := true
        } else if starts_with(arg, "--") {
            die("unknown option \"" + arg + "\"")
        } else {
            positionals = push(positionals, arg)
        }
        i = i + 1
    }
    opts["positionals"] := positionals
    return opts
}

func valid_render_format(format) {
    return format == "all" || format == "svg" || format == "html" || format == "markdown"
}

func validate_opts(opts) {
    if valid_render_format(opts["format"]) == false {
        die("--format must be one of: all, svg, html, markdown")
    }
    platform := opts["platform"]
    if platform != "" && platform != "x" {
        die("--platform must be x")
    }
    if is_safe_output_dir(opts["out"]) == false {
        die("--out must be a safe directory path (not blank, root, '.', '..', traversal, or ambiguous segments)")
    }
}

func option_value(argv, i, flag) {
    if i + 1 >= len(argv) {
        die(flag + " requires a value")
    }
    value := argv[i + 1]
    if starts_with(value, "--") {
        die(flag + " requires a value")
    }
    return value
}

func parse_positive_int(value, flag) {
    mut parsed := 0
    mut threw := false
    try {
        parsed = parse_int(value)
    } except e {
        threw = true
    }
    if threw || parsed < 1 {
        die(flag + " must be a positive integer")
    }
    return parsed
}

func limits_from_opts(opts) {
    mut limits := default_limits()
    limits["max_code_lines"] := opts["max_code_lines"]
    limits["max_output_lines"] := opts["max_output_lines"]
    return limits
}

# Directory containing a file path, "" when there is none.
func dir_of(path) {
    idx := last_slash(path)
    if idx < 0 {
        return ""
    }
    return substring(path, 0, idx)
}

func last_slash(s) {
    n := len(s)
    mut i := 0
    mut found := 0 - 1
    while i < n {
        if char_at(s, i) == "/" {
            found = i
        }
        i = i + 1
    }
    return found
}

# ---- output helpers ----------------------------------------------------

# Preserve identical outputs so a no-op rebuild does not invalidate mtimes or
# downstream caches. Plain write_file refuses to overwrite changed files on the
# VM; atomic replacement keeps the old file intact if writing fails.
func write_out(path, content) {
    return write_output(path, content, true)
}

func write_output(path, content, overwrite) {
    if file_exists(path) && path_is_symlink(path) {
        die("output must not be a symlink: " + path)
    }
    if file_exists(path) && path_is_file(path) == false {
        die("output must be a regular file: " + path)
    }
    if file_exists(path) && overwrite {
        previous := read_file(path)
        if type(previous) == "Error" {
            die("cannot read existing output: " + path)
        }
        if previous == content {
            return false
        }
    }
    result := write_file_atomic(path, content, overwrite)
    if type(result) == "Error" {
        die("cannot write output: " + path + ": " + to_string(result))
    }
    return true
}

func ensure_dir(path) {
    if file_exists(path) && path_is_dir(path) == false {
        die("not a directory: " + path)
    }
    if file_exists(path) == false {
        result := create_dir(path)
        if type(result) == "Error" {
            die("cannot create directory: " + path)
        }
    }
}

func wants(format, kind) {
    return format == "all" || format == kind
}

func print_problems(problems) {
    n := len(problems)
    mut i := 0
    while i < n {
        print("  - " + problems[i])
        i = i + 1
    }
}

func print_manifest_problems(problems) {
    print("howl: manifest has " + to_string(len(problems)) + " problem(s):")
    print_problems(problems)
}

func print_field(label, value) {
    print(label + value)
}

func print_section(title) {
    print("")
    print("--- " + title + " ---")
}

func print_card_listing(card) {
    print(card["id"] + "  —  " + card["title"])
    print("    file: " + card["file"])
    concepts := card["concepts"]
    if len(concepts) > 0 {
        print("    concepts: " + comma_list(concepts))
    }
}

func print_card_metadata(card) {
    print_field("id:       ", card["id"])
    print_field("title:    ", card["title"])
    if is_blank(card["tagline"]) == false {
        print_field("tagline:  ", card["tagline"])
    }
    print_field("file:     ", card["file"])
    print_field("language: ", card["language"])
    concepts := card["concepts"]
    if len(concepts) > 0 {
        print_field("concepts: ", comma_list(concepts))
    }
}

# ---- shared load -------------------------------------------------------

# Load + validate every manifest entry; defer content reads to each command. Centralized so every
# command fails the same clear way on a bad manifest.
func load_model(opts) {
    manifest_path := opts["manifest"]
    data := load_manifest(manifest_path)
    base := dir_of(manifest_path)
    problems := validate_manifest(data, base)
    if len(problems) > 0 {
        print_manifest_problems(problems)
        exit(1)
    }
    mut model := {}
    model["project"] := manifest_project(data)
    model["cards"] := data["cards"]
    model["base"] := base
    return model
}

func require_card(cards, id) {
    card := find_card(cards, id)
    if type(card) == "null" {
        die("no card with id \"" + id + "\"")
    }
    return card
}

# ---- commands ----------------------------------------------------------

func cmd_validate(opts) {
    manifest_path := opts["manifest"]
    data := load_manifest(manifest_path)
    base := dir_of(manifest_path)
    problems := validate_manifest(data, base)
    if len(problems) > 0 {
        print_manifest_problems(problems)
        return 1
    }
    count := len(data["cards"])
    print("ok: " + manifest_path + " is valid (" + to_string(count) + " card(s))")
    return 0
}

func cmd_list(opts) {
    model := load_model(opts)
    cards := model["cards"]
    n := len(cards)
    mut i := 0
    while i < n {
        print_card_listing(card_metadata(cards[i]))
        i = i + 1
    }
    if n == 0 {
        print("(no cards)")
    }
    return 0
}

func cmd_show(opts) {
    id := first_positional(opts, "show")
    model := load_model(opts)
    raw := require_card(model["cards"], id)
    card := build_card_preview(raw, model["base"], limits_from_opts(opts))
    print_card_metadata(card)
    print_section("code preview")
    print(card["code"])
    if card["code_truncated"] == true {
        print("... (truncated)")
    }
    if is_blank(card["expected_output"]) == false {
        print_section("expected output")
        print(card["expected_output"])
        if card["expected_truncated"] == true {
            print("... (truncated)")
        }
    }
    return 0
}

func cmd_caption(opts) {
    id := first_positional(opts, "caption")
    model := load_model(opts)
    card := card_metadata(require_card(model["cards"], id))
    if opts["platform"] == "x" {
        print(build_caption_x(card, model["project"]))
    } else {
        print(build_caption(card, model["project"]))
    }
    return 0
}

func write_card_outputs(out, format, card, project) {
    id := card["id"]
    mut written := 0
    if wants(format, "markdown") {
        write_out(join_path(out, id + ".md"), render_markdown(card, project))
        written = written + 1
    }
    if wants(format, "html") {
        write_out(join_path(out, id + ".html"), render_html(card, project))
        written = written + 1
    }
    if wants(format, "svg") {
        write_out(join_path(out, id + ".svg"), render_svg(card, project))
        written = written + 1
    }
    return written
}

# Reject source/output collisions before writing any artifacts. Existing input
# paths are canonical keys, so hard-to-spot aliases cannot overwrite examples.
func protect_render_inputs(opts, model) {
    mut inputs := {}
    inputs[path_absolute(opts["manifest"])] := true
    cards := model["cards"]
    mut i := 0
    while i < len(cards) {
        raw := cards[i]
        keys := ["file", "background_image", "font_file"]
        mut j := 0
        while j < len(keys) {
            key := keys[j]
            if has_key(raw, key) == 1 && is_blank(raw[key]) == false {
                inputs[path_absolute(resolve_contained_path(model["base"], raw[key])["path"])] := true
            }
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < len(cards) {
        id := cards[i]["id"]
        if wants(opts["format"], "markdown") {
            protect_target(join_path(opts["out"], id + ".md"), inputs)
        }
        if wants(opts["format"], "html") {
            protect_target(join_path(opts["out"], id + ".html"), inputs)
        }
        if wants(opts["format"], "svg") {
            protect_target(join_path(opts["out"], id + ".svg"), inputs)
        }
        i = i + 1
    }
    if wants(opts["format"], "html") {
        protect_target(join_path(opts["out"], "index.html"), inputs)
    }
}

func protect_target(path, inputs) {
    if file_exists(path) {
        if path_is_symlink(path) || path_is_file(path) == false {
            die("output must be a regular non-symlink file: " + path)
        }
        if has_key(inputs, path_absolute(path)) == 1 {
            die("output would overwrite an input file: " + path)
        }
    }
}

func cmd_render(opts) {
    model := load_model(opts)
    cards := model["cards"]
    project := model["project"]
    out := opts["out"]
    format := opts["format"]
    ensure_dir(out)
    protect_render_inputs(opts, model)
    n := len(cards)
    mut i := 0
    mut written := 0
    mut gallery_cards := []
    while i < n {
        raw := cards[i]
        mut card := {}
        if wants(format, "svg") {
            card = build_card(raw, model["base"], limits_from_opts(opts))
        } else {
            card = build_card_preview(raw, model["base"], limits_from_opts(opts))
        }
        if wants(format, "html") {
            gallery_cards = push(gallery_cards, card_metadata(raw))
        }
        written = written + write_card_outputs(out, format, card, project)
        i = i + 1
    }
    if wants(format, "html") {
        write_out(join_path(out, "index.html"), render_gallery(gallery_cards, project, format))
        written = written + 1
    }
    print("rendered " + to_string(n) + " card(s) -> " + ensure_trailing_slash(out) + " (" + to_string(written) + " files)")
    return 0
}

func first_positional(opts, cmd) {
    positionals := opts["positionals"]
    if len(positionals) == 0 {
        die(cmd + " requires a card id (try `howl list`)")
    }
    return positionals[0]
}

# ---- init --------------------------------------------------------------

# Scaffold a starter manifest and one example. Never clobber existing files
# unless --force is given.
func cmd_init(opts) {
    force := truthy(opts["force"])
    manifest_path := opts["manifest"]
    manifest_dir := dir_of(manifest_path)
    mut made := 0

    if is_blank(manifest_dir) == false {
        ensure_dir(manifest_dir)
    }
    mut examples_dir := "examples"
    if is_blank(manifest_dir) == false {
        examples_dir = join_path(manifest_dir, "examples")
    }
    ensure_dir(examples_dir)
    example_path := join_path(examples_dir, "clear-intent.kujo")
    if file_exists(example_path) && force == false {
        print("skip (exists): " + example_path)
    } else {
        write_output(example_path, starter_example(), force)
        made = made + 1
    }

    if file_exists(manifest_path) && force == false {
        print("skip (exists): " + manifest_path + " (use --force to overwrite)")
    } else {
        write_output(manifest_path, starter_manifest(), force)
        made = made + 1
    }

    if made == 0 {
        print("nothing created; manifest and example already exist")
    } else {
        print("created " + to_string(made) + " file(s); next: howl render")
    }
    return 0
}

func starter_example() {
    return "# Clear intent over boilerplate.\n# A tiny program that says what it does, with nothing extra.\n\nfunc greet(name) {\n    return \"Ready, \" + name\n}\n\nprint(greet(\"agent\"))\n"
}

# Built as a dict and serialized so the output is always valid JSON.
func starter_manifest() {
    mut card := {}
    card["id"] := "clear-intent"
    card["title"] := "Clear intent over boilerplate"
    card["tagline"] := "Kujo favors code that humans and agents can continue safely."
    card["file"] := "examples/clear-intent.kujo"
    card["language"] := "kujo"
    card["concepts"] := ["clear intent", "agent-readable code", "low-noise syntax"]
    card["expected_output"] := "Ready, agent"
    card["caption"] := "AI-native software needs code that explains intent without burying it in ceremony."
    card["cta"] := "Kujo: programming language for AI-native software."

    mut project := {}
    project["name"] := "Kujo"
    project["tagline"] := "Programming language for AI-native software"
    project["url"] := ""

    mut theme := {}
    theme["name"] := "minimal"
    theme["mode"] := "light"

    mut manifest := {}
    manifest["project"] := project
    manifest["theme"] := theme
    manifest["cards"] := [card]
    return to_json_pretty(manifest) + "\n"
}

# ---- help / dispatch ---------------------------------------------------

func help_text() {
    # One literal block (not a push-built list) to keep allocations low.
    return "howl — turn Kujo examples into shareable showcase artifacts\n\nUsage: howl <command> [options]\n\nCommands:\n  init                 Scaffold howl.json + examples/ (won't overwrite)\n  validate             Validate the manifest and referenced files\n  list                 List cards (id, title, file, concepts)\n  show <id>            Show one card's metadata and code preview\n  caption <id>         Print a deterministic share caption\n  render               Render SVG + Markdown + HTML + gallery\n  help                 Show this help\n  version              Show version\n\nOptions:\n  --manifest PATH      Manifest file (default: howl.json)\n  --out DIR            Output dir for render (default: dist/howl)\n  --format FMT         all | svg | html | markdown (default: all)\n  --platform x         Caption variant for X.com (caption only)\n  --max-code-lines N   Code lines per card before truncation (default: 40)\n  --max-output-lines N Output lines per card before truncation (default: 20)\n  --force              Allow init to overwrite existing files\n\nHowl is offline and deterministic: it never posts to social media,\nnever calls AI/network APIs, and never invents claims about Kujo."
}

export func main(argv) {
    try {
        # The launcher imports from Howl's own directory, then restores the
        # caller's directory before interpreting any manifest/output paths.
        if len(argv) >= 2 && argv[0] == "--howl-caller-dir" {
            os_chdir(argv[1])
            return dispatch(slice(argv, 2, len(argv)))
        }
        return dispatch(argv)
    } except e {
        die(to_string(e))
    }
    return 1
}

func dispatch(argv) {
    if len(argv) == 0 {
        print(help_text())
        return 0
    }
    cmd := argv[0]
    opts := parse_opts(argv)
    validate_opts(opts)
    if cmd == "init" {
        return cmd_init(opts)
    }
    if cmd == "validate" {
        return cmd_validate(opts)
    }
    if cmd == "list" {
        return cmd_list(opts)
    }
    if cmd == "show" {
        return cmd_show(opts)
    }
    if cmd == "caption" {
        return cmd_caption(opts)
    }
    if cmd == "render" {
        return cmd_render(opts)
    }
    if cmd == "help" || cmd == "--help" || cmd == "-h" {
        print(help_text())
        return 0
    }
    if cmd == "version" || cmd == "--version" || cmd == "-v" {
        print("howl " + VERSION)
        return 0
    }
    print("howl: unknown command \"" + cmd + "\" (try `howl help`)")
    return 1
}
