# Markdown renderer: one .md file per card.
#
# Markdown is the most portable artifact (README sections, GitHub discussions,
# blog drafts), so we keep it plain and diff-friendly. Manifest prose is
# escaped as text, while example code stays inside a fence that adapts if the
# code itself contains backticks.

from src.util import is_blank, comma_list, escape_html, truthy
from src.caption import build_caption

func repeat_char(char, count) {
    mut out := ""
    mut i := 0
    while i < count {
        out = out + char
        i = i + 1
    }
    return out
}

func longest_run(s, target) {
    mut longest := 0
    mut current := 0
    mut i := 0
    while i < len(s) {
        if char_at(s, i) == target {
            current = current + 1
            if current > longest {
                longest = current
            }
        } else {
            current = 0
        }
        i = i + 1
    }
    return longest
}

func fence_marker(body) {
    run := longest_run(body, "`")
    if run < 3 {
        return "```"
    }
    return repeat_char("`", run + 1)
}

func fence_language(language) {
    if is_blank(language) {
        return ""
    }
    if truthy(contains(language, "\n")) {
        return ""
    }
    if truthy(contains(language, "`")) {
        return ""
    }
    return language
}

func fence(language, body) {
    marker := fence_marker(body)
    return marker + fence_language(language) + "\n" + body + "\n" + marker
}

export func render_markdown(card, project) {
    mut out := "# " + escape_html(card["title"]) + "\n"
    if is_blank(card["tagline"]) == false {
        out = out + "\n" + escape_html(card["tagline"]) + "\n"
    }
    out = out + "\n" + fence(card["language"], card["code"]) + "\n"
    if card["code_truncated"] == true {
        out = out + "\n> Example truncated for display. See the source file for the full example.\n"
    }
    if is_blank(card["expected_output"]) == false {
        out = out + "\n**Expected output:**\n\n" + fence("text", card["expected_output"]) + "\n"
        if card["expected_truncated"] == true {
            out = out + "\n> Expected output truncated for display.\n"
        }
    }
    concepts := card["concepts"]
    if len(concepts) > 0 {
        out = out + "\n**Concepts:** " + escape_html(comma_list(concepts)) + "\n"
    }
    if is_blank(card["notes"]) == false {
        out = out + "\n" + escape_html(card["notes"]) + "\n"
    }
    out = out + "\n---\n\n" + escape_html(build_caption(card, project)) + "\n"
    return out
}
