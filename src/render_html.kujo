# HTML renderer: one standalone .html file per card.
#
# Self-contained: embedded CSS, no remote fonts, scripts, or assets, so the
# file works fully offline and is safe to drop anywhere. All card-derived text
# is escaped before it reaches the page.
#
# Strings are built by direct concatenation into a single accumulator rather
# than push-into-a-list-then-join, and static blocks (CSS) are single string
# literals. This keeps total allocations low — the Kujo runtime here has a
# cumulative-allocation ceiling, so low-noise output is also a correctness
# requirement (see docs/session-notes.md).

from src.util import escape_html, is_blank, is_safe_link_url
from src.caption import build_caption

# Minimal black/white technical aesthetic with one restrained accent. System
# font stack only — no font files are bundled or fetched. One static literal.
func html_style() {
    return ":root{--bg:#fff;--fg:#111;--muted:#666;--line:#e5e5e5;--accent:#2563eb;--code-bg:#0f1115;--code-fg:#e6e6e6}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;line-height:1.5}.card{max-width:760px;margin:48px auto;padding:0 24px}.eyebrow{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 8px}h1{font-size:30px;line-height:1.2;margin:0 0 8px}.tagline{font-size:18px;color:var(--muted);margin:0 0 24px}pre{background:var(--code-bg);color:var(--code-fg);padding:18px 20px;border-radius:10px;overflow:auto;font-family:'SF Mono',Menlo,Consolas,monospace;font-size:14px;line-height:1.55}pre.out{background:#f6f7f9;color:#111;border:1px solid var(--line)}code{font-family:'SF Mono',Menlo,Consolas,monospace}.label{font-size:13px;letter-spacing:.04em;text-transform:uppercase;color:var(--muted);margin:24px 0 8px}.concepts{display:flex;flex-wrap:wrap;gap:8px;margin:24px 0}.chip{border:1px solid var(--line);border-radius:999px;padding:4px 12px;font-size:13px;color:var(--fg)}.note{color:var(--muted);font-size:14px;margin:8px 0}.trunc{color:var(--accent);font-size:13px;margin:8px 0 0}.caption{border-top:1px solid var(--line);margin-top:32px;padding-top:20px;color:var(--fg);white-space:pre-wrap;font-size:15px}footer{color:var(--muted);font-size:13px;margin-top:24px}a{color:var(--accent)}"
}

func concept_chips(concepts) {
    if len(concepts) == 0 {
        return ""
    }
    mut out := "<div class=\"concepts\">"
    mut i := 0
    while i < len(concepts) {
        out = out + "<span class=\"chip\">" + escape_html(concepts[i]) + "</span>"
        i = i + 1
    }
    return out + "</div>"
}

func project_name(project) {
    if type(project) == "null" {
        return "Kujo"
    }
    if has_key(project, "name") == 1 {
        if is_blank(project["name"]) == false {
            return project["name"]
        }
    }
    return "Kujo"
}

export func render_html(card, project) {
    title := escape_html(card["title"])
    mut out := "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
    out = out + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    out = out + "<title>" + title + "</title>\n<style>" + html_style() + "</style>\n</head>\n"
    out = out + "<body>\n<main class=\"card\">\n"
    out = out + "<p class=\"eyebrow\">" + escape_html(project_name(project)) + "</p>\n"
    out = out + "<h1>" + title + "</h1>\n"
    if is_blank(card["tagline"]) == false {
        out = out + "<p class=\"tagline\">" + escape_html(card["tagline"]) + "</p>\n"
    }
    out = out + "<pre><code>" + escape_html(card["code"]) + "</code></pre>\n"
    if card["code_truncated"] == true {
        out = out + "<p class=\"trunc\">Example truncated for display. See the source file for the full example.</p>\n"
    }
    if is_blank(card["expected_output"]) == false {
        out = out + "<p class=\"label\">Expected output</p>\n"
        out = out + "<pre class=\"out\"><code>" + escape_html(card["expected_output"]) + "</code></pre>\n"
        if card["expected_truncated"] == true {
            out = out + "<p class=\"trunc\">Expected output truncated for display.</p>\n"
        }
    }
    out = out + concept_chips(card["concepts"]) + "\n"
    if is_blank(card["notes"]) == false {
        out = out + "<p class=\"note\">" + escape_html(card["notes"]) + "</p>\n"
    }
    out = out + "<div class=\"caption\">" + escape_html(build_caption(card, project)) + "</div>\n"
    if is_blank(card["url"]) == false && is_safe_link_url(card["url"]) {
        u := escape_html(card["url"])
        out = out + "<footer><a href=\"" + u + "\">" + u + "</a></footer>\n"
    }
    return out + "</main>\n</body>\n</html>\n"
}
