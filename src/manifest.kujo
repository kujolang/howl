# Manifest loading, validation, and the card data model.
#
# The manifest (howl.json by default) is the single source of truth. This
# module turns it into a list of fully-resolved "card" dicts: metadata from the
# manifest plus the example file's text, already truncated to card-sized
# limits. Renderers consume these dicts and never touch the filesystem.

from src.util import die, is_blank, is_safe_id, split_lines, take_lines, resolve_contained_path

# ---- defaults ----------------------------------------------------------

# Conservative, deterministic limits keep cards readable and shareable.
export func default_limits() {
    return {"max_code_lines": 40, "max_code_chars": 4000, "max_output_lines": 20}
}

# ---- loading -----------------------------------------------------------

# Read and parse the manifest into a raw dict. Fails clearly when the file is
# missing or the JSON does not parse, so the user never sees a raw stack.
export func load_manifest(path) {
    if file_exists(path) == false {
        die("manifest not found: " + path + " (run `howl init` to create one)")
    }
    content := read_file(path)
    data := parse_json(content)
    if type(data) == "Error" {
        die("manifest is not valid JSON: " + path)
    }
    return data
}

export func manifest_project(data) {
    if has_key(data, "project") == 1 {
        return data["project"]
    }
    return {}
}

export func manifest_theme(data) {
    if has_key(data, "theme") == 1 {
        return data["theme"]
    }
    return {}
}

export func manifest_cards(data) {
    if has_key(data, "cards") == 1 {
        return data["cards"]
    }
    return []
}

# ---- validation --------------------------------------------------------

# Return a list of human-readable problem strings ([] means valid). Every
# problem is collected so a user can fix a manifest in one pass.
export func validate_manifest(data, base_dir) {
    mut problems := []
    if type(data) != "dict" {
        problems = push(problems, "manifest must be a JSON object")
        return problems
    }
    problems = manifest_metadata_problems(problems, data)
    if has_key(data, "cards") == 0 {
        problems = push(problems, "manifest has no \"cards\" array")
        return problems
    }
    cards := data["cards"]
    if type(cards) != "array" {
        problems = push(problems, "manifest \"cards\" must be an array")
        return problems
    }
    n := len(cards)
    if n == 0 {
        problems = push(problems, "manifest \"cards\" array is empty")
    }
    mut seen := {}
    mut i := 0
    while i < n {
        card := cards[i]
        where := "card[" + to_string(i) + "]"
        cp := card_problems(card, where, base_dir)
        mut j := 0
        while j < len(cp) {
            problems = push(problems, cp[j])
            j = j + 1
        }
        if has_key(card, "id") == 1 {
            id := card["id"]
            if is_safe_id(id) {
                if has_key(seen, id) == 1 {
                    problems = push(problems, where + ": duplicate id \"" + id + "\"")
                }
                seen[id] := true
            }
        }
        i = i + 1
    }
    return problems
}

func manifest_metadata_problems(problems, data) {
    mut out := problems
    if has_key(data, "project") == 1 {
        project := data["project"]
        if type(project) != "dict" {
            out = push(out, "manifest \"project\" must be an object")
        } else {
            out = optional_string_problem(out, project, "project", "name")
            out = optional_string_problem(out, project, "project", "tagline")
            out = optional_string_problem(out, project, "project", "url")
        }
    }
    if has_key(data, "theme") == 1 {
        theme := data["theme"]
        if type(theme) != "dict" {
            out = push(out, "manifest \"theme\" must be an object")
        } else {
            out = optional_string_problem(out, theme, "theme", "name")
            out = optional_string_problem(out, theme, "theme", "mode")
        }
    }
    return out
}

func optional_string_problem(problems, card, where, key) {
    mut out := problems
    if has_key(card, key) == 1 {
        v := card[key]
        if type(v) != "null" && type(v) != "string" {
            out = push(out, where + ": \"" + key + "\" must be a string")
        }
    }
    return out
}

func optional_bool_problem(problems, card, where, key) {
    mut out := problems
    if has_key(card, key) == 1 {
        v := card[key]
        if type(v) != "null" && type(v) != "bool" {
            out = push(out, where + ": \"" + key + "\" must be a boolean")
        }
    }
    return out
}

func concepts_problem(problems, card, where) {
    mut out := problems
    if has_key(card, "concepts") == 1 {
        concepts := card["concepts"]
        if type(concepts) == "null" {
            return out
        }
        if type(concepts) != "array" {
            out = push(out, where + ": \"concepts\" must be an array of strings")
            return out
        }
        mut i := 0
        while i < len(concepts) {
            if type(concepts[i]) != "string" {
                out = push(out, where + ": \"concepts[" + to_string(i) + "]\" must be a string")
            }
            i = i + 1
        }
    }
    return out
}

func optional_file_problem(problems, card, where, key, base_dir) {
    mut out := problems
    if has_key(card, key) == 0 {
        return out
    }
    value := card[key]
    if type(value) != "string" {
        return push(out, where + ": \"" + key + "\" must be a string")
    }
    if is_blank(value) {
        return out
    }
    resolved := resolve_contained_path(base_dir, value)
    if resolved["ok"] == false {
        return push(out, where + ": referenced " + key + " escapes manifest directory: " + value)
    }
    if file_exists(resolved["path"]) == false {
        return push(out, where + ": referenced " + key + " not found: " + value)
    }
    return out
}

# Required fields for a single card: id, title, file. Everything else is
# optional. Duplicate-id detection lives in validate_manifest (it owns the
# shared `seen` set).
export func card_problems(card, where, base_dir) {
    mut problems := []
    if type(card) != "dict" {
        problems = push(problems, where + ": card must be an object")
        return problems
    }
    if has_key(card, "id") == 0 {
        problems = push(problems, where + ": missing required field \"id\"")
    } else {
        id := card["id"]
        if type(id) != "string" {
            problems = push(problems, where + ": \"id\" must be a string")
        } else if is_safe_id(id) == false {
            problems = push(problems, where + ": id \"" + to_string(id) + "\" is not filesystem-safe (use a-z 0-9 - _)")
        }
    }
    if has_key(card, "title") == 0 {
        problems = push(problems, where + ": missing required field \"title\"")
    } else {
        title := card["title"]
        if type(title) != "string" {
            problems = push(problems, where + ": \"title\" must be a string")
        } else if is_blank(title) {
            problems = push(problems, where + ": \"title\" must not be empty")
        }
    }
    if has_key(card, "file") == 0 {
        problems = push(problems, where + ": missing required field \"file\"")
    } else {
        file := card["file"]
        if type(file) != "string" {
            problems = push(problems, where + ": \"file\" must be a string")
        } else if is_blank(file) {
            problems = push(problems, where + ": \"file\" must not be empty")
        } else {
            resolved := resolve_contained_path(base_dir, file)
            if resolved["ok"] == false {
                problems = push(problems, where + ": referenced file escapes manifest directory: " + file)
            } else if file_exists(resolved["path"]) == false {
                problems = push(problems, where + ": referenced file not found: " + file)
            }
        }
    }
    problems = optional_string_problem(problems, card, where, "tagline")
    problems = optional_string_problem(problems, card, where, "language")
    problems = optional_string_problem(problems, card, where, "expected_output")
    problems = optional_string_problem(problems, card, where, "caption")
    problems = optional_string_problem(problems, card, where, "cta")
    problems = optional_string_problem(problems, card, where, "notes")
    problems = optional_string_problem(problems, card, where, "url")
    problems = optional_string_problem(problems, card, where, "variant")
    problems = optional_string_problem(problems, card, where, "label")
    problems = optional_bool_problem(problems, card, where, "show_border")
    problems = optional_bool_problem(problems, card, where, "show_url")
    problems = optional_file_problem(problems, card, where, "background_image", base_dir)
    problems = optional_file_problem(problems, card, where, "font_file", base_dir)
    problems = concepts_problem(problems, card, where)
    return problems
}

# Manifest file paths are relative to the manifest's directory.
export func resolve_file(base_dir, rel) {
    resolved := resolve_contained_path(base_dir, rel)
    if resolved["ok"] == false {
        return ""
    }
    return resolved["path"]
}

# ---- card model --------------------------------------------------------

func opt_str(card, key) {
    if has_key(card, key) == 0 {
        return ""
    }
    v := card[key]
    if type(v) == "null" {
        return ""
    }
    return v
}

func opt_list(card, key) {
    if has_key(card, key) == 0 {
        return []
    }
    v := card[key]
    if type(v) == "null" {
        return []
    }
    return v
}

func opt_bool(card, key, fallback) {
    if has_key(card, key) == 0 {
        return fallback
    }
    v := card[key]
    if type(v) == "null" {
        return fallback
    }
    return v
}

func default_language(raw) {
    if has_key(raw, "language") == 0 {
        return "kujo"
    }
    v := raw["language"]
    if is_blank(v) {
        return "kujo"
    }
    return v
}

func asset_mime(path) {
    lower := to_lower(path)
    if ends_with(lower, ".webp") {
        return "image/webp"
    }
    if ends_with(lower, ".png") {
        return "image/png"
    }
    if ends_with(lower, ".jpg") || ends_with(lower, ".jpeg") {
        return "image/jpeg"
    }
    if ends_with(lower, ".svg") {
        return "image/svg+xml"
    }
    if ends_with(lower, ".woff2") {
        return "font/woff2"
    }
    if ends_with(lower, ".woff") {
        return "font/woff"
    }
    return "application/octet-stream"
}

func embedded_asset(raw, key, base_dir) {
    rel := opt_str(raw, key)
    if is_blank(rel) {
        return ""
    }
    full := resolve_file(base_dir, rel)
    if is_blank(full) || file_exists(full) == false {
        return ""
    }
    bytes := read_binary_file(full)
    if type(bytes) == "Error" {
        return ""
    }
    return "data:" + asset_mime(rel) + ";base64," + encode_base64(bytes)
}

# Truncate code by lines first, then characters; return both the shown text and
# honest bookkeeping so renderers can show a "truncated" notice instead of
# silently dropping content.
func truncate_code(code, limits) {
    max_lines := limits["max_code_lines"]
    max_chars := limits["max_code_chars"]
    total_lines := len(split_lines(code))
    mut truncated := false
    mut shown := code
    if total_lines > max_lines {
        shown = take_lines(code, max_lines)
        truncated = true
    }
    if len(shown) > max_chars {
        shown = substring(shown, 0, max_chars)
        truncated = true
    }
    return {"shown": shown, "truncated": truncated, "total": total_lines, "shown_lines": len(split_lines(shown))}
}

func truncate_output(out, limits) {
    max_lines := limits["max_output_lines"]
    mut truncated := false
    mut shown := out
    if len(split_lines(out)) > max_lines {
        shown = take_lines(out, max_lines)
        truncated = true
    }
    return {"shown": shown, "truncated": truncated}
}

# Resolve one raw manifest entry into a render-ready card dict: read the example
# file, apply truncation, and normalize optional fields so renderers stay dumb.
export func build_card(raw, base_dir, limits) {
    full := resolve_file(base_dir, raw["file"])
    mut code := ""
    if file_exists(full) {
        code = read_file(full)
    }
    ct := truncate_code(code, limits)
    ot := truncate_output(opt_str(raw, "expected_output"), limits)

    mut card := {}
    card["id"] := raw["id"]
    card["title"] := raw["title"]
    card["file"] := raw["file"]
    card["tagline"] := opt_str(raw, "tagline")
    card["language"] := default_language(raw)
    card["concepts"] := opt_list(raw, "concepts")
    card["caption"] := opt_str(raw, "caption")
    card["cta"] := opt_str(raw, "cta")
    card["notes"] := opt_str(raw, "notes")
    card["url"] := opt_str(raw, "url")
    card["variant"] := opt_str(raw, "variant")
    card["label"] := opt_str(raw, "label")
    card["show_border"] := opt_bool(raw, "show_border", true)
    card["show_url"] := opt_bool(raw, "show_url", true)
    card["background_image"] := opt_str(raw, "background_image")
    card["background_data"] := embedded_asset(raw, "background_image", base_dir)
    card["font_file"] := opt_str(raw, "font_file")
    card["font_data"] := embedded_asset(raw, "font_file", base_dir)
    card["code"] := ct["shown"]
    card["code_truncated"] := ct["truncated"]
    card["code_total_lines"] := ct["total"]
    card["code_shown_lines"] := ct["shown_lines"]
    card["expected_output"] := ot["shown"]
    card["expected_truncated"] := ot["truncated"]
    return card
}

export func build_cards(data, base_dir, limits) {
    raw_cards := manifest_cards(data)
    mut result := []
    n := len(raw_cards)
    mut i := 0
    while i < n {
        result = push(result, build_card(raw_cards[i], base_dir, limits))
        i = i + 1
    }
    return result
}

export func find_card(cards, id) {
    n := len(cards)
    mut i := 0
    while i < n {
        c := cards[i]
        if c["id"] == id {
            return c
        }
        i = i + 1
    }
    return null
}
