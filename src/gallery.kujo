# Static gallery index: a single index.html linking every rendered card.
#
# Intentionally small — a flat, offline, inspectable list, not a website
# framework. Links are relative so the whole dist/howl/ folder is portable.
# Built by single-string accumulation with a literal CSS block to keep total
# allocations low (see docs/session-notes.md).

from src.util import escape_html, is_blank

func gallery_style() {
    return "*{box-sizing:border-box}body{margin:0;background:#fafafa;color:#111;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;line-height:1.5}.wrap{max-width:960px;margin:48px auto;padding:0 24px}header h1{font-size:32px;margin:0 0 4px}header p{color:#666;margin:0 0 32px;font-size:18px}.grid{display:grid;gap:20px}.item{background:#fff;border:1px solid #e5e5e5;border-radius:12px;padding:20px 24px}.item h2{font-size:20px;margin:0 0 4px}.item .tag{color:#666;margin:0 0 12px}.chips{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 14px}.chip{border:1px solid #e5e5e5;border-radius:999px;padding:2px 10px;font-size:12px;color:#444}.links a{margin-right:14px;font-size:14px;color:#2563eb;text-decoration:none}footer{color:#999;font-size:13px;margin-top:40px}"
}

func chips_html(concepts) {
    if len(concepts) == 0 {
        return ""
    }
    mut out := "<div class=\"chips\">"
    mut i := 0
    while i < len(concepts) {
        out = out + "<span class=\"chip\">" + escape_html(concepts[i]) + "</span>"
        i = i + 1
    }
    return out + "</div>"
}

func gallery_item(card) {
    id := card["id"]
    mut out := "<article class=\"item\">\n<h2>" + escape_html(card["title"]) + "</h2>\n"
    if is_blank(card["tagline"]) == false {
        out = out + "<p class=\"tag\">" + escape_html(card["tagline"]) + "</p>\n"
    }
    out = out + chips_html(card["concepts"]) + "\n"
    out = out + "<div class=\"links\">"
    out = out + "<a href=\"" + id + ".html\">HTML</a>"
    out = out + "<a href=\"" + id + ".svg\">SVG</a>"
    out = out + "<a href=\"" + id + ".md\">Markdown</a>"
    out = out + "</div>\n</article>"
    return out
}

export func render_gallery(cards, project) {
    mut name := "Kujo"
    mut tagline := ""
    if type(project) != "null" {
        if has_key(project, "name") == 1 {
            if is_blank(project["name"]) == false {
                name = project["name"]
            }
        }
        if has_key(project, "tagline") == 1 {
            tagline = project["tagline"]
        }
    }
    esc_name := escape_html(name)
    mut out := "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
    out = out + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    out = out + "<title>" + esc_name + " showcase</title>\n<style>" + gallery_style() + "</style>\n</head>\n"
    out = out + "<body>\n<div class=\"wrap\">\n<header>\n<h1>" + esc_name + " showcase</h1>\n"
    if is_blank(tagline) == false {
        out = out + "<p>" + escape_html(tagline) + "</p>\n"
    }
    out = out + "</header>\n<div class=\"grid\">\n"
    mut i := 0
    while i < len(cards) {
        out = out + gallery_item(cards[i]) + "\n"
        i = i + 1
    }
    out = out + "</div>\n<footer>Generated by Howl. Static, offline, no tracking.</footer>\n"
    out = out + "</div>\n</body>\n</html>\n"
    return out
}
