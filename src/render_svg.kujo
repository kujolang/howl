# SVG renderer: one .svg file per card.
#
# Deterministic, safe-escaped SVG layouts: the default 1600x900 showcase card
# and a 1200x630 background-backed social variant. Optional local image/font
# assets are embedded as data URLs, so outputs remain self-contained.
#
# Built by single-string accumulation with a literal <style> block to keep
# total allocations low (see docs/session-notes.md).

from src.util import escape_html, is_blank, comma_list

# ---- text shaping for fixed-width layout -------------------------------

func clip(s, max) {
    if len(s) <= max {
        return s
    }
    return substring(s, 0, max - 1) + "…"
}

func cap_lines(lines, max_lines) {
    n := len(lines)
    if n <= max_lines {
        return lines
    }
    mut out := []
    mut i := 0
    while i < max_lines {
        mut line := lines[i]
        if i == max_lines - 1 {
            line = line + " …"
        }
        out = push(out, line)
        i = i + 1
    }
    return out
}

# Greedy word wrap into at most max_lines lines. The final line is marked when
# content remains, so long titles never overflow the card.
func wrap_words(text, max_chars, max_lines) {
    words := split(text, " ")
    mut lines := []
    mut current := ""
    n := len(words)
    mut i := 0
    while i < n {
        w := words[i]
        mut fitted := w
        if len(fitted) > max_chars {
            fitted = clip(fitted, max_chars)
        }
        mut candidate := fitted
        if current != "" {
            candidate = current + " " + fitted
        }
        if len(candidate) <= max_chars {
            current = candidate
        } else {
            if current != "" {
                lines = push(lines, current)
            }
            current = fitted
        }
        i = i + 1
    }
    if current != "" {
        lines = push(lines, current)
    }
    return cap_lines(lines, max_lines)
}

# How many 38px rows fit in a panel of height `panel_h` (with 60px padding).
func rows_that_fit(panel_h) {
    avail := panel_h - 60
    mut rows := 0
    while (rows + 1) * 38 <= avail {
        rows = rows + 1
    }
    return rows
}

# ---- svg emission ------------------------------------------------------

func text_el(x, y, cls, content) {
    return "<text x=\"" + to_string(x) + "\" y=\"" + to_string(y) + "\" class=\"" + cls + "\">" + escape_html(content) + "</text>\n"
}

# Append wrapped/word lines as <text> elements onto `acc`, returning the new
# accumulator. Avoids building an intermediate list of elements.
func emit_lines(acc, lines, x, start_y, line_h, cls) {
    mut out := acc
    n := len(lines)
    mut i := 0
    mut y := start_y
    while i < n {
        out = out + text_el(x, y, cls, lines[i])
        y = y + line_h
        i = i + 1
    }
    return out
}

func svg_styles() {
    return ".eyebrow{font-family:monospace;font-size:26px;fill:#2563eb;letter-spacing:6px}.title{font-family:sans-serif;font-size:66px;font-weight:700;fill:#111}.tag{font-family:sans-serif;font-size:30px;fill:#666}.code{font-family:monospace;font-size:26px;fill:#e6e6e6}.concepts{font-family:sans-serif;font-size:26px;fill:#666}.cta{font-family:sans-serif;font-size:26px;font-weight:600;fill:#111}"
}

func project_name(project) {
    if type(project) == "null" {
        return "KUJO"
    }
    if has_key(project, "name") == 1 {
        if is_blank(project["name"]) == false {
            return to_upper(project["name"])
        }
    }
    return "KUJO"
}

func cta_text(card, project) {
    if is_blank(card["cta"]) == false {
        return card["cta"]
    }
    if type(project) != "null" {
        if has_key(project, "tagline") == 1 {
            if is_blank(project["tagline"]) == false {
                return project["tagline"]
            }
        }
    }
    return ""
}

func social_font_face(card) {
    if is_blank(card["font_data"]) {
        return ""
    }
    mut format := "woff2"
    if ends_with(to_lower(card["font_file"]), ".woff") {
        format = "woff"
    }
    return "@font-face{font-family:'HowlMono';src:url('" + card["font_data"] + "') format('" + format + "');font-weight:400;font-style:normal;font-display:block}"
}

func social_label(card) {
    if is_blank(card["label"]) == false {
        return to_upper(card["label"])
    }
    return "KUJO"
}

func social_brand(project) {
    if type(project) == "null" {
        return "KUJO"
    }
    if has_key(project, "url") == 1 {
        raw_url := project["url"]
        if is_blank(raw_url) == false {
            url := trim(raw_url)
            mut host := replace(url, "https://", "")
            host = replace(host, "http://", "")
            if starts_with(host, "www.") {
                host = substring(host, 4, len(host))
            }
            slash := index_of(host, "/")
            if slash >= 0 {
                host = substring(host, 0, slash)
            }
            if is_blank(host) == false {
                return to_upper(host)
            }
        }
    }
    if has_key(project, "name") == 1 {
        if is_blank(project["name"]) == false {
            return to_upper(project["name"])
        }
    }
    return "KUJO"
}

func social_url(card, project) {
    if is_blank(card["url"]) == false {
        return card["url"]
    }
    if type(project) != "null" && has_key(project, "url") == 1 {
        return project["url"]
    }
    return ""
}

func social_title_size(title) {
    if len(title) > 24 {
        return 58
    }
    if len(title) > 15 {
        return 68
    }
    return 82
}

func svg_open(width, height, card) {
    mut out := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + to_string(width) + "\" height=\"" + to_string(height) + "\" viewBox=\"0 0 " + to_string(width) + " " + to_string(height) + "\""
    if is_blank(card["alt"]) {
        return out + ">\n"
    }
    title_id := "howl-title-" + card["id"]
    desc_id := "howl-desc-" + card["id"]
    out = out + " role=\"img\" aria-labelledby=\"" + title_id + " " + desc_id + "\">\n"
    out = out + "<title id=\"" + title_id + "\">" + escape_html(card["title"]) + "</title>\n"
    return out + "<desc id=\"" + desc_id + "\">" + escape_html(card["alt"]) + "</desc>\n"
}

func render_social_svg(card, project) {
    mut out := svg_open(1200, 630, card)
    out = out + "<defs><linearGradient id=\"wash\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\"><stop offset=\"0\" stop-color=\"#fff\" stop-opacity=\".98\"/><stop offset=\".52\" stop-color=\"#fff\" stop-opacity=\".88\"/><stop offset=\".82\" stop-color=\"#fff\" stop-opacity=\".18\"/><stop offset=\"1\" stop-color=\"#fff\" stop-opacity=\"0\"/></linearGradient><filter id=\"grain\"><feTurbulence type=\"fractalNoise\" baseFrequency=\".82\" numOctaves=\"2\" seed=\"17\"/><feColorMatrix type=\"saturate\" values=\"0\"/><feComponentTransfer><feFuncA type=\"table\" tableValues=\"0 .055\"/></feComponentTransfer></filter></defs>\n"
    out = out + "<style>" + social_font_face(card) + ".mono{font-family:'HowlMono','Departure Mono',monospace;font-weight:400}.label{font-size:18px;letter-spacing:4px;fill:#111}.social-title{font-size:" + to_string(social_title_size(card["title"])) + "px;fill:#050505;letter-spacing:-2px}.social-tag{font-size:24px;fill:#282828}.social-url{font-size:17px;letter-spacing:1px;fill:#111}</style>\n"
    if card["transparent"] == false {
        if is_blank(card["background_data"]) == false {
            out = out + "<image href=\"" + card["background_data"] + "\" x=\"0\" y=\"0\" width=\"1200\" height=\"630\" preserveAspectRatio=\"xMidYMid slice\"/>\n"
        } else {
            out = out + "<rect width=\"1200\" height=\"630\" fill=\"#f4f4f1\"/>\n"
        }
        out = out + "<rect width=\"1200\" height=\"630\" fill=\"url(#wash)\"/>\n"
        out = out + "<rect width=\"1200\" height=\"630\" filter=\"url(#grain)\" opacity=\".7\"/>\n"
    }
    if card["show_border"] {
        out = out + "<rect x=\"42\" y=\"42\" width=\"1116\" height=\"546\" fill=\"none\" stroke=\"#111\" stroke-width=\"1\"/>\n"
    }
    out = out + text_el(78, 98, "mono label", social_brand(project) + "  //  " + social_label(card))

    title_lines := wrap_words(card["title"], 20, 3)
    out = emit_lines(out, title_lines, 76, 232, social_title_size(card["title"]) + 10, "mono social-title")
    mut y := 232 + len(title_lines) * (social_title_size(card["title"]) + 10)
    if is_blank(card["tagline"]) == false {
        tag_lines := wrap_words(card["tagline"], 47, 2)
        out = emit_lines(out, tag_lines, 78, y + 18, 34, "mono social-tag")
    }
    if card["show_url"] {
        url := social_url(card, project)
        if is_blank(url) == false {
            out = out + text_el(78, 548, "mono social-url", url)
        }
    }
    out = out + "<rect x=\"78\" y=\"570\" width=\"84\" height=\"4\" fill=\"#111\"/>\n"
    return out + "</svg>\n"
}

# Append the code lines (clipped/capped) as <text> elements onto `acc`.
func emit_code(acc, code, max_lines, max_cols, x, start_y, line_h) {
    raw := split(replace(code, "\r\n", "\n"), "\n")
    n := len(raw)
    mut limit := n
    if limit > max_lines {
        limit = max_lines
    }
    mut out := acc
    mut i := 0
    mut y := start_y
    while i < limit {
        out = out + text_el(x, y, "code", clip(raw[i], max_cols))
        y = y + line_h
        i = i + 1
    }
    if n > max_lines {
        out = out + text_el(x, y, "code", "… (" + to_string(n - max_lines) + " more lines)")
    }
    return out
}

export func render_svg(card, project) {
    if card["variant"] == "social" {
        return render_social_svg(card, project)
    }
    mut out := svg_open(1600, 900, card)
    out = out + "<style>" + svg_styles() + "</style>\n"
    out = out + "<rect width=\"1600\" height=\"900\" fill=\"#ffffff\"/>\n"
    out = out + "<rect x=\"0\" y=\"0\" width=\"1600\" height=\"10\" fill=\"#2563eb\"/>\n"

    out = out + text_el(80, 120, "eyebrow", project_name(project))

    title_lines := wrap_words(card["title"], 34, 2)
    out = emit_lines(out, title_lines, 80, 210, 78, "title")
    mut y := 210 + len(title_lines) * 78

    if is_blank(card["tagline"]) == false {
        tag_lines := wrap_words(card["tagline"], 70, 2)
        out = emit_lines(out, tag_lines, 80, y + 8, 40, "tag")
        y = y + 8 + len(tag_lines) * 40
    }

    # Code panel fills the remaining vertical space above the footer.
    panel_y := y + 24
    panel_h := 800 - panel_y
    out = out + "<rect x=\"80\" y=\"" + to_string(panel_y) + "\" width=\"1440\" height=\"" + to_string(panel_h) + "\" rx=\"16\" fill=\"#0f1115\"/>\n"
    out = emit_code(out, card["code"], rows_that_fit(panel_h), 78, 116, panel_y + 56, 38)

    concepts := card["concepts"]
    if len(concepts) > 0 {
        out = out + text_el(80, 858, "concepts", comma_list(concepts))
    }
    cta := cta_text(card, project)
    if is_blank(cta) == false {
        out = out + text_el(80, 895, "cta", clip(cta, 90))
    }

    return out + "</svg>\n"
}
