{
  "name": "howl-launch-readiness",
  "version": "1.1.0",
  "tests": [
    {
      "name": "Howl help succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "./bin/howl help"
      }
    },
    {
      "name": "Howl version succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "./bin/howl version"
      }
    },
    {
      "name": "Howl validate succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "./bin/howl validate"
      }
    },
    {
      "name": "Howl test suite succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "./tests/run.sh"
      }
    },
    {
      "name": "Howl release regression succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "python3 tests/release_regression.py"
      }
    }
  ]
}
